{
  "about": "Fixed command set for scripts/compat-differential.js: every case runs against the published reference exe and against the freshly built exe, and stdout, stderr and exit code must match byte for byte. ${CMD} expands to the runner's own <SystemRoot>\\System32\\cmd.exe and ${WORKDIR} to a scratch directory the runner creates (it holds noop.bat and an agents/ directory with fake claude/codex .bat files), so no case depends on the caller's working directory, PATH order or temp path. An optional \"env\" object overrides single environment variables for both sides. Every case may pin an \"expect\" block ({ exit, stdoutIncludes, stderrIncludes }) that BOTH builds must satisfy, so a case that silently took another path (a stand-in agent that was not found, say) fails instead of matching.",
  "cases": [
    { "name": "help-wnice", "tool": "wnice", "args": ["--help"] },
    { "name": "help-idle", "tool": "idle", "args": ["--help"] },
    { "name": "help-belownormal", "tool": "belownormal", "args": ["--help"] },
    { "name": "help-abovenormal", "tool": "abovenormal", "args": ["--help"] },
    { "name": "help-high", "tool": "high", "args": ["--help"] },
    { "name": "help-realtime", "tool": "realtime", "args": ["--help"] },
    { "name": "help-capc", "tool": "capc", "args": ["--help"] },
    { "name": "help-capt", "tool": "capt", "args": ["--help"] },
    { "name": "help-capm", "tool": "capm", "args": ["--help"] },
    { "name": "help-caps", "tool": "caps", "args": ["--help"] },
    { "name": "help-capn", "tool": "capn", "args": ["--help"] },
    { "name": "help-admin", "tool": "admin", "args": ["--help"] },
    { "name": "help-uiup", "tool": "uiup", "args": ["--help"] },
    { "name": "help-flag-short-idle", "tool": "idle", "args": ["-h"] },
    { "name": "help-flag-slashq-capc", "tool": "capc", "args": ["/?"] },
    { "name": "help-flag-short-uiup", "tool": "uiup", "args": ["-h"] },

    { "name": "usage-no-command", "tool": "wnice", "args": [] },
    { "name": "usage-unknown-option", "tool": "wnice", "args": ["--bogus"] },
    { "name": "usage-unknown-short-option", "tool": "wnice", "args": ["-x"] },
    { "name": "usage-equals-form", "tool": "wnice", "args": ["--priority=idle", "${CMD}"] },
    { "name": "usage-clustered-short-option", "tool": "wnice", "args": ["-pc", "idle", "${CMD}"] },
    { "name": "usage-missing-priority-value", "tool": "wnice", "args": ["-p"] },
    { "name": "usage-missing-timeout-value", "tool": "wnice", "args": ["--timeout"] },
    { "name": "usage-bad-priority", "tool": "wnice", "args": ["-p", "bogus", "${CMD}"] },
    { "name": "usage-cpu-zero", "tool": "wnice", "args": ["-c", "0", "${CMD}"] },
    { "name": "usage-cpu-fraction", "tool": "wnice", "args": ["-c", "50.5", "${CMD}"] },
    { "name": "usage-threads-too-many", "tool": "wnice", "args": ["-t", "64", "${CMD}"] },
    { "name": "usage-memory-percent-range", "tool": "wnice", "args": ["-m", "101", "${CMD}"] },
    { "name": "usage-memory-bad-unit", "tool": "wnice", "args": ["-m", "512kb", "${CMD}"] },
    { "name": "usage-procs-zero", "tool": "wnice", "args": ["-n", "0", "${CMD}"] },
    { "name": "usage-timeout-zero", "tool": "wnice", "args": ["-s", "0", "${CMD}"] },
    { "name": "usage-timeout-sub-millisecond", "tool": "wnice", "args": ["-s", "0.0009", "${CMD}"] },
    { "name": "usage-wsl-empty-distro", "tool": "wnice", "args": ["--wsl=", "${CMD}"] },
    { "name": "usage-wsl-accepted-cpu-error", "tool": "wnice", "args": ["--wsl", "-c", "0", "${CMD}"] },
    { "name": "usage-wsl-distro-accepted-threads-error", "tool": "wnice", "args": ["--wsl=Ubuntu-24.04", "-t", "64", "${CMD}"] },
    { "name": "usage-boost-without-priority", "tool": "wnice", "args": ["--boost", "${CMD}"] },
    { "name": "usage-boost-with-wsl", "tool": "wnice", "args": ["--wsl", "--boost", "-p", "high", "${CMD}"] },
    { "name": "usage-double-dash-only", "tool": "wnice", "args": ["--"] },
    { "name": "usage-memory-overflow-digits", "tool": "wnice", "args": ["-m", "9999999999999999999999999999999m", "${CMD}"] },
    { "name": "usage-memory-overflow-bytes", "tool": "wnice", "args": ["-m", "18446744073709551616m", "${CMD}"] },
    { "name": "usage-unknown-frontend", "tool": "wnice-compat-not-a-tool", "args": [] },

    { "name": "usage-idle-no-command", "tool": "idle", "args": [] },
    { "name": "usage-abovenormal-no-command", "tool": "abovenormal", "args": [] },
    { "name": "usage-capc-no-value", "tool": "capc", "args": [] },
    { "name": "usage-capc-no-command", "tool": "capc", "args": ["50"] },
    { "name": "usage-capc-out-of-range", "tool": "capc", "args": ["101", "${CMD}"] },
    { "name": "usage-capt-zero", "tool": "capt", "args": ["0", "${CMD}"] },
    { "name": "usage-capm-fraction-percent", "tool": "capm", "args": ["50.5", "${CMD}"] },
    { "name": "usage-capm-percent-sign", "tool": "capm", "args": ["25%", "${CMD}"] },
    { "name": "usage-caps-zero", "tool": "caps", "args": ["0", "${CMD}"] },
    { "name": "usage-capn-zero", "tool": "capn", "args": ["0", "${CMD}"] },
    { "name": "usage-admin-no-command", "tool": "admin", "args": [] },

    { "name": "run-exit-0", "tool": "wnice", "args": ["--", "${CMD}", "/c", "exit", "0"] },
    { "name": "run-exit-7", "tool": "wnice", "args": ["--", "${CMD}", "/c", "exit", "7"] },
    { "name": "run-exit-255", "tool": "wnice", "args": ["--", "${CMD}", "/c", "exit", "255"] },
    { "name": "run-exit-negative", "tool": "wnice", "args": ["--", "${CMD}", "/c", "exit", "-1"] },
    { "name": "run-priority-high", "tool": "wnice", "args": ["-p", "high", "--", "${CMD}", "/c", "exit", "2"] },
    { "name": "run-boost-note", "tool": "wnice", "args": ["--boost", "-p", "high", "--", "${CMD}", "/c", "exit", "3"] },
    { "name": "run-capc-exit", "tool": "capc", "args": ["50", "${CMD}", "/c", "exit", "6"] },
    { "name": "run-caps-exit", "tool": "caps", "args": ["5", "${CMD}", "/c", "exit", "4"] },
    { "name": "run-idle-exit", "tool": "idle", "args": ["${CMD}", "/c", "exit", "5"] },
    { "name": "run-trailing-jobs-arg", "tool": "wnice", "args": ["${CMD}", "/c", "echo", "--jobs"], "expect": { "exit": 0, "stdoutIncludes": "--jobs" } },
    { "name": "run-trailing-jobs-arg-after-option", "tool": "wnice", "args": ["-c", "50", "${CMD}", "/c", "echo", "--jobs"], "expect": { "exit": 0, "stdoutIncludes": "--jobs" } },
    { "name": "run-bat-ok", "tool": "wnice", "args": ["--", "${WORKDIR}\\noop.bat"] },
    { "name": "run-percent-refused", "tool": "wnice", "args": ["--", "${WORKDIR}\\noop.bat", "100%OFF"] },
    { "name": "run-not-found", "tool": "wnice", "args": ["--", "wnice-compat-no-such-command"] },
    { "name": "run-not-found-legacy", "tool": "idle", "args": ["wnice-compat-no-such-command"] },
    { "name": "run-timeout-124", "tool": "caps", "args": ["1", "${CMD}", "/c", "ping -n 30 127.0.0.1 >nul"] },

    { "name": "help-cy-forwarded", "tool": "cy", "args": ["--help"], "env": { "PATH": "${WORKDIR}\\agents", "PATHEXT": ".COM;.EXE;.BAT;.CMD" }, "expect": { "exit": 7, "stdoutIncludes": "--dangerously-skip-permissions --help" } },
    { "name": "help-cx-forwarded", "tool": "cx", "args": ["--help"], "env": { "PATH": "${WORKDIR}\\agents", "PATHEXT": ".COM;.EXE;.BAT;.CMD" }, "expect": { "exit": 8, "stdoutIncludes": "--dangerously-bypass-approvals-and-sandbox --help" } },
    { "name": "help-cy-no-agent", "tool": "cy", "args": ["--help"], "env": { "PATH": "${WORKDIR}", "PATHEXT": ".COM;.EXE;.BAT;.CMD" }, "expect": { "exit": 127, "stderrIncludes": "command not found" } }
  ]
}
